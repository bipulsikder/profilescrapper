{
  "name": "peoplegpt-platform",
  "version": "2.0.0",
  "description": "Enhanced PeopleGPT platform with deep requirement analysis and Indian candidate focus",
  "private": true,
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm install && npm run build",
    "build:frontend": "next build",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "next dev",
    "start": "next start",
    "lint": "next lint",
    "deploy": "npm run build && vercel --prod"
  },
  "dependencies": {
    "lucide-react": "^0.294.0",
    "next": "14.2.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hot-toast": "2.4.1",
    "sonner": "^1.2.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/cors": "^2.8.19",
    "@types/node": "^20.9.0",
    "@types/react": "19.2.5",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.33",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "concurrently": "^8.2.2",
    "vercel": "^39.0.0"
  },
  "engines": {
    "node": "20.x"
  }
}