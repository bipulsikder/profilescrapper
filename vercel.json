{
  "version": 2,
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd backend && npm install && npm run build && cd ../frontend && npm run build",
  "outputDirectory": "frontend/.next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/search"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}