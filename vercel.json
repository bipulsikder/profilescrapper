{
  "version": 2,
  "rootDirectory": "frontend",
  "installCommand": "npm install",
  "buildCommand": "cd ../backend && npm install && npm run build && cd ../frontend && npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "functions": {
    "api/search.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/search"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}